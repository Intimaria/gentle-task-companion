# Datos (API DynamoDB) — ScyllaDB Alternator en self-host
DYNAMODB_ENDPOINT=http://scylla:8000
TABLE_NAME=gentle
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Auth OIDC — emisor de DESARROLLO (mock-oidc). En producción: Cognito (AWS) o Authentik (self-host).
# El issuer es el que ve el NAVEGADOR (localhost:8081), para que el claim `iss` del token
# coincida. El JWKS es independiente del issuer: el backend trae las claves in-network
# (mock-oidc:8080, siempre alcanzable) — mismo mock, mismas claves.
OIDC_ISSUER=http://localhost:8081/default
OIDC_JWKS_URI=http://mock-oidc:8080/default/jwks
OIDC_AUDIENCE=gentle
# RBAC dev: mock-oidc no emite `groups` por-usuario, así que en desarrollo el rol admin
# se otorga por `sub`. En prod el admin viene del claim `groups` del IdP (Cognito/Authentik).
# Logueate como "admin" en el navegador para ver /admin; "demo-user" es el sub del smoke.
ADMIN_SUBS=demo-user,admin

# Object storage (API S3) — MinIO en self-host. Como el OIDC, hay split-horizon:
# S3_ENDPOINT = interno (el backend sube/lee por la red de docker);
# S3_PUBLIC_ENDPOINT = el host que ve el NAVEGADOR, con el que se PREFIRMAN las URLs.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=gentle-media
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

PORT=8080
